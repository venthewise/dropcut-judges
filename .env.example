# Copy to .env for local runs, or set these in Vercel > Project > Settings > Environment Variables.
COMFY_CLOUD_API_KEY=your-comfy-cloud-api-key
COMFY_DEPLOYMENT_ENDPOINT=https://your-deployment-endpoint.example
# 32+ random characters. Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=replace-with-64-hex-characters
# Judge accounts (scrypt hashes only). Generate: node scripts/add-judge.mjs --env
# Locally this can stay unset; judges.json is used instead.
JUDGE_ACCOUNTS={"judge1":{"salt":"<32 hex>","hash":"<128 hex>"}}
